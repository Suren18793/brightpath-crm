# ==============================================================================
# BrightPath CRM — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in your project root and provide your Supabase keys:
#
#   cp .env.example .env
#
# Where to find these in Supabase:
# 1. Log in to https://supabase.com/dashboard
# 2. Select your BrightPath CRM project
# 3. Navigate to: Project Settings (gear icon) -> API
# 4. Copy the "Project URL" and the "anon / public" API key
#
# IMPORTANT SECURITY NOTICE:
# - VITE_ variables are bundled into the public browser build.
# - NEVER put your 'service_role' secret key or database password in this file.
# - The '.env' file is already excluded in .gitignore to protect your credentials.
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (starts with eyJ...)
VITE_SUPABASE_ANON_KEY=your-anon-public-client-key
